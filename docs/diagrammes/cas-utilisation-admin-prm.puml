@startuml cas-utilisation-admin-prm
!theme plain
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontSize 11
}
skinparam actor {
  BackgroundColor white
  BorderColor #334155
}
skinparam arrow {
  Color #475569
}

title Diagramme de cas d'utilisation — Administrateur et PRM\nPortail des marchés publics — Dakar Dem Dikk

left to right direction

actor "Personne responsable\ndu marché (PRM)" as PRM
actor "Administrateur" as ADMIN

rectangle "Gestion des appels d'offres" {
  usecase "Créer un appel d'offres" as UC_CREATE_AO
  usecase "Ajouter des documents\nsur un AO" as UC_DOCS_AO
  usecase "Modifier un appel d'offres" as UC_EDIT_AO
  usecase "Publier un appel d'offres" as UC_PUBLISH_AO
  usecase "Clôturer un appel d'offres" as UC_CLOSE_AO
  usecase "Réouvrir un appel d'offres\nclôturé" as UC_REOPEN_AO
  usecase "Définir les modalités de\ndépôt physique" as UC_MODALITES
  usecase "Configurer l'accès au cahier\n(gratuit ou payant)" as UC_CAHIER
  usecase "Consulter l'annuaire\ndes fournisseurs" as UC_ANNUAIRE
}

rectangle "Authentification" {
  usecase "Se connecter" as UC_LOGIN
  usecase "Se déconnecter" as UC_LOGOUT
}

rectangle "Administration et pilotage" {
  usecase "Créer un compte PRM" as UC_CREATE_PRM
  usecase "Assigner un AO à un PRM" as UC_ASSIGN_AO
  usecase "Valider / rejeter /\nsuspendre / réactiver\nun compte fournisseur" as UC_FOURNISSEUR
  usecase "Attribuer un marché\n(AO clôturé)" as UC_ATTRIBUTION
  usecase "Repasser un AO publié\nen brouillon" as UC_UNPUBLISH
  usecase "Consulter logs, audits\net statistiques" as UC_AUDIT
  usecase "Consulter les suggestions" as UC_SUGGESTIONS
  usecase "Gérer les messages\nde contact" as UC_CONTACT
}

' --- Authentification (PRM et Admin — page /connexion commune)
PRM --> UC_LOGIN
PRM --> UC_LOGOUT
ADMIN --> UC_LOGIN
ADMIN --> UC_LOGOUT

' --- PRM
PRM --> UC_CREATE_AO
PRM --> UC_DOCS_AO
PRM --> UC_EDIT_AO
PRM --> UC_PUBLISH_AO
PRM --> UC_CLOSE_AO
PRM --> UC_REOPEN_AO
PRM --> UC_ANNUAIRE

' --- Admin hérite du PRM + droits étendus
ADMIN -|> PRM
ADMIN --> UC_CREATE_PRM
ADMIN --> UC_ASSIGN_AO
ADMIN --> UC_FOURNISSEUR
ADMIN --> UC_ATTRIBUTION
ADMIN --> UC_UNPUBLISH
ADMIN --> UC_AUDIT
ADMIN --> UC_SUGGESTIONS
ADMIN --> UC_CONTACT

' --- Includes (contraintes métier)
UC_CREATE_AO ..> UC_MODALITES : <<include>>
UC_EDIT_AO ..> UC_MODALITES : <<include>>
UC_PUBLISH_AO ..> UC_MODALITES : <<include>>
UC_CREATE_AO ..> UC_CAHIER : <<include>>
UC_EDIT_AO ..> UC_CAHIER : <<include>>

note right of UC_LOGIN
  Page unique /connexion (Sanctum).
  Redirection selon le rôle :
  PRM → tableau de bord responsable,
  Admin → tableau de bord admin.
  Le PRM ne peut pas s'inscrire :
  son compte est créé par l'administrateur.
end note

note right of UC_MODALITES
  Obligatoire avant publication.
  Le dépôt des plis reste physique
  au siège (non substitué par le portail).
end note

note bottom of UC_UNPUBLISH
  Action réservée à l'administrateur.
  Aucune suppression ni archivage
  des AO publiés (traçabilité).
end note

@enduml
