@startuml cas-utilisation-fournisseur
!theme plain
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontSize 11
}
skinparam actor {
  BackgroundColor white
  BorderColor #334155
}
skinparam arrow {
  Color #475569
}

title Diagramme de cas d'utilisation — Fournisseur\nPortail des marchés publics — Dakar Dem Dikk

left to right direction

actor "Fournisseur" as FOURNISSEUR

rectangle "Authentification" {
  usecase "S'inscrire" as UC_REGISTER
  usecase "Se connecter" as UC_LOGIN
  usecase "Se déconnecter" as UC_LOGOUT
  usecase "Soumettre les documents\nlégaux" as UC_LEGAL_DOCS
}

rectangle "Consultation des marchés" {
  usecase "Consulter la liste des\nappels d'offres" as UC_LIST_AO
  usecase "Consulter le détail d'un\nappel d'offres" as UC_DETAIL_AO
  usecase "Consulter les modalités de\ndépôt physique" as UC_MODALITES
}

rectangle "Documents et cahier des charges" {
  usecase "Télécharger les pièces\ngratuites (avis, règlement)" as UC_DL_FREE
  usecase "Télécharger le cahier\ndes charges" as UC_DL_CAHIER
  usecase "Payer le cahier\ndes charges" as UC_PAY_CAHIER
  usecase "Régler via Wave /\nOrange Money" as UC_PAYMENT_MEANS
  usecase "Gérer les documents\nlégaux" as UC_MANAGE_LEGAL
  usecase "Consulter mes achats\n(cahiers payés)" as UC_MES_ACHATS
}

rectangle "Espace personnel et suivi" {
  usecase "Modifier le profil\nentreprise" as UC_PROFILE
  usecase "Consulter les\nnotifications" as UC_NOTIF
  usecase "Soumettre une\nsuggestion" as UC_SUGGESTION
  usecase "Utiliser l'assistant\nconversationnel (IA)" as UC_CHAT
  usecase "Soumettre une candidature\nen ligne" as UC_CANDIDATURE
}

' --- Authentification
FOURNISSEUR --> UC_REGISTER
FOURNISSEUR --> UC_LOGIN
FOURNISSEUR --> UC_LOGOUT

' --- Consultation
FOURNISSEUR --> UC_LIST_AO
FOURNISSEUR --> UC_DETAIL_AO
FOURNISSEUR --> UC_MODALITES

' --- Documents et cahier
FOURNISSEUR --> UC_DL_FREE
FOURNISSEUR --> UC_DL_CAHIER
FOURNISSEUR --> UC_MANAGE_LEGAL
FOURNISSEUR --> UC_MES_ACHATS

' --- Espace personnel
FOURNISSEUR --> UC_PROFILE
FOURNISSEUR --> UC_NOTIF
FOURNISSEUR --> UC_SUGGESTION
FOURNISSEUR --> UC_CHAT

' --- Includes
UC_REGISTER ..> UC_LEGAL_DOCS : <<include>>
UC_PAY_CAHIER ..> UC_PAYMENT_MEANS : <<include>>

' --- Extends
UC_PAY_CAHIER ..> UC_DL_CAHIER : <<extend>>\n[si payant]
UC_CANDIDATURE ..> UC_DETAIL_AO : <<extend>>\n[si candidature\nen ligne activée]

' --- Notes
note right of UC_LOGIN
  Compte créé en statut **en_attente** :
  connexion autorisée pour compléter
  le dossier, payer le cahier et
  télécharger les documents.
  Statut **actif** après validation
  par l'administrateur.
end note

note bottom of UC_MODALITES
  Le dépôt des plis reste **physique**
  au siège (non substitué par le portail).
  Modalités visibles sur la fiche du marché.
end note

note right of UC_LIST_AO
  Consultation des AO également
  possible **sans compte** (visiteur).
  Le téléchargement du cahier payant
  nécessite une connexion fournisseur.
end note

note right of UC_PAYMENT_MEANS
  Moyens configurés sur le serveur :
  Wave, Orange Money ou simulation
  (environnement de test).
end note

@enduml
