APP_NAME="Portail des marchés Publics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:8080

# --- CORS / Sanctum (SPA cross-origin) ---
# Origines autorisées séparées par des virgules (sans espace, schéma inclus).
# En production : mettre la/les URL(s) du frontend (avec HTTPS).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
# Domaines considérés comme « stateful » (SPA sur le même registrable domain que l'API).
# Format Sanctum : "domaine.tld,sous.domaine.tld" — pas de schéma, pas de port en prod HTTPS.
SANCTUM_STATEFUL_DOMAINS=localhost:8081,127.0.0.1:8081,localhost:5173,127.0.0.1:5173
# Domaine de cookie de session (laisser vide en dev). En prod, le domaine racine partagé
# entre front et API (ex. ".mon-domaine.sn") pour que les cookies soient partagés.
SESSION_DOMAIN=
# En prod (HTTPS) : mettre true pour forcer les cookies à n'être envoyés que sur HTTPS.
SESSION_SECURE_COOKIE=false

# Requêtes / minute sur les routes API (middleware throttle "api"). Utilisateur connecté vs invité.
API_RATE_LIMIT_PER_MINUTE=400
API_RATE_LIMIT_GUEST_PER_MINUTE=150

# --- Paiement cahier des charges (Wave / Orange Money) ---
# URL publique du backend pour les webhooks (APP_URL accessible depuis Internet en prod).
# FRONTEND_URL = origine du front Vite/React (retours success/error après paiement).

# Wave Checkout API — https://docs.wave.com/checkout
WAVE_CHECKOUT_ENABLED=false
WAVE_API_BASE=https://api.wave.com
WAVE_API_KEY=
# Optionnel : signature des requêtes API sortantes (si activée sur la clé dans le portail Wave)
WAVE_SIGNING_SECRET=
# Secret webhook (wave_sn_WHS_...) — enregistrer l’URL https://VOTRE_API/api/webhooks/wave/cahier chez Wave
WAVE_WEBHOOK_SECRET=
# En dev : après retour Wave, POST verifier-wave interroge l’API Wave (si webhook pas exposé)
WAVE_ALLOW_SYNC_VERIFY=false

# Orange Money — contrat opérateur ; URL et format JSON à ajuster selon la doc du pays
ORANGE_MONEY_WEBPAY_ENABLED=false
ORANGE_MONEY_INIT_URL=
ORANGE_MONEY_INIT_METHOD=POST
ORANGE_MONEY_API_TOKEN=
ORANGE_MONEY_RESPONSE_URL_KEY=payment_url
ORANGE_MONEY_WEBHOOK_SECRET=

# Démo / soutenance : page « PAYER » simulée — aucun débit ; nécessite FRONTEND_URL = origine du front Vite.
# Si vous laissez cette ligne commentée ou vide : en local (`APP_ENV=local`) la simulation reste activée par défaut (voir config/paiement.php).
# En production : mettre explicitement false ou ne pas dépendre de la valeur par défaut locale.
CAHIER_PAIEMENT_SIMULATION=true

# Mettre true seulement si le dépôt en ligne des offres est autorisé (défaut : soumission physique au siège).
CANDIDATURE_EN_LIGNE=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AI (chatbot fournisseur)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=500
AI_TIMEOUT_SECONDS=20

# Boîte qui reçoit les messages du formulaire Contact (portail)
MAIL_CONTACT_ADDRESS=appel.offre@demdikk.sn

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
